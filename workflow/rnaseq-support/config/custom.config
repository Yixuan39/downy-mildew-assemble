process {
    executor = 'slurm'
    errorStrategy = 'retry'
    maxRetries = 1
    withLabel:process_low {
        cpus = 4
    }
    withLabel:process_medium {
        cpus = 16
        memory = '200 GB'
    }
    withLabel:process_high {
        cpus = 24
        memory = '200 GB'
    }
    withName: 'NFCORE_RNASEQ:RNASEQ:KRAKEN2' {
        cpus = 24
        memory = '300 GB'
    }
}

executor {
    name = 'slurm'
}
