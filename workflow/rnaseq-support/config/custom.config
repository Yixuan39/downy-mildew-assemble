process {
    executor = 'slurm'
    errorStrategy = 'retry'
    maxRetries = 1
    withLabel:process_low {
        cpus = 4
    }
    withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        time = 10.d
    }
    withName: 'NFCORE_RNASEQ:RNASEQ:KRAKEN2' {
        memory = '256 GB'
    }
}

executor {
    name = 'slurm'
}
